# Cloudflare Workers static assets reads this file natively (so does
# Pages). Everything chops-search emits under /search/ carries a content
# hash EXCEPT manifest.json and the three runtime files, so those are the
# only entries that don't get pinned for a year.
#
# The wasm under /search/pkg/ is unhashed on disk but always requested
# with ?v=<build hash> by the worker, so it is safe to pin: a rebuild
# changes the query string and therefore the browser's cache key.
#
# Verify after deploying:
#   curl -sI https://<host>/search/index.<hash>.bin | grep -i cache-control
#   curl -sI https://<host>/search/manifest.json    | grep -i cache-control

/search/model.*
  Cache-Control: public, max-age=31536000, immutable

/search/index.*
  Cache-Control: public, max-age=31536000, immutable

/search/snippets.*
  Cache-Control: public, max-age=31536000, immutable

/search/pkg/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest is the entry point: it names every hashed file, so it must
# not go stale or the browser asks for artifacts that no longer exist.
/search/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed runtime. chops-search.js now loads on EVERY page (the overlay),
# so must-revalidate would cost a conditional request per navigation.
# Five minutes bounds the staleness window after an upgrade without that
# per-page round trip — and a stale page script paired with fresh
# artifacts degrades to "search unavailable", not to wrong results.
/search/chops-search.js
  Cache-Control: public, max-age=300

/search/chops-search.css
  Cache-Control: public, max-age=300

/search/search-worker.js
  Cache-Control: public, max-age=300
