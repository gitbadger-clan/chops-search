# ==========================================
# Rust / Cargo Output
# ==========================================
/target/
**/*.rs.bk

# Note: Keep `Cargo.lock` if this is a binary/runnable app rather than a library.
# Uncomment the line below if you prefer to commit Cargo.lock for libraries:
# !Cargo.lock

# ==========================================
# Wasm Tooling & Build Artefacts
# ==========================================
# wasm-pack output directory (default)
/pkg/

# Trunk output directory (default)
/dist/

# Wasm bindgen generated files (if not using default output dir)
/wasm-pkg/

# Intermediate WebAssembly build caches
.wasm-pack/
.cargo-ok/

# ==========================================
# Node.js / Frontend Integration (npm/yarn/pnpm)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Local environment variables
.env
.env.local
.env.*.local

# ==========================================
# IDEs, Editors & OS Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / RustRover / CLion
.idea/
*.iml

# Vim / Emacs
*~
*.swp
*.swo
\#*\#
.\#*

/.chops-search/model/
/target/
/examples/demo-site/static/search/
/examples/demo-site/public/
